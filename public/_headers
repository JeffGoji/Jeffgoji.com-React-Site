/gallery/:gallery/thumbs/*
  Cache-Control: public, max-age=31536000, immutable

/gallery/:gallery/display/*
  Cache-Control: public, max-age=31536000, immutable

# original/ keeps raw source filenames (not content-hashed) -- do NOT mark immutable, it'll serve stale for a year
/gallery/:gallery/original/*
  Cache-Control: public, max-age=3600, must-revalidate

/gallery/:gallery/manifest.json
  Cache-Control: public, max-age=300

# hero/ renditions keep stable per-car filenames (not content-hashed), so a
# swapped hero photo must not serve stale for a year -- a day, revalidated.
# The manifest rule is listed first deliberately: /hero/* also matches it, and
# the ladder must not outlive a rebuild that changes it.
/hero/manifest.json
  Cache-Control: public, max-age=300

/hero/*
  Cache-Control: public, max-age=86400, must-revalidate
